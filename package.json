{
  "name": "jec-index",
  "version": "0.2.0",
  "description": "MCP server + Claude Code hook: a persistent, incremental symbol and dependency index so Claude reads slices instead of files, sees impact before editing, and runs only the tests that matter.",
  "type": "module",
  "bin": {
    "jec-index": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    "hooks",
    ".mcp.json",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node dist/smoke.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keiththornton/jec-index.git"
  },
  "homepage": "https://github.com/keiththornton/jec-index#readme"
}
